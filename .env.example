# ─────────────────────────────────────────────────────────────
# LunchBox — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── Supabase (Frontend) ───────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Supabase Edge Function Secrets ───────────────────────────
# Set these with the Supabase CLI, NOT here:
#   supabase secrets set RESEND_API_KEY=re_...
#   supabase secrets set FROM_EMAIL=lunch@yourdomain.com
#   supabase secrets set APP_URL=https://yourdomain.com
#
# For reference:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx   ← from resend.com
# SUPABASE_SERVICE_ROLE_KEY=              ← auto-available in Edge Functions
# FROM_EMAIL=lunch@yourdomain.com
# APP_URL=https://yourdomain.com
